rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Evidence uploads: userId-scoped, authenticated, max 50MB
    match /evidence/{userId}/{farmId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|video/.*');
    }

    // Farm boundary GeoJSON
    match /boundaries/{farmId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }

    // Profile photos
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
